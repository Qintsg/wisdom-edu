# 行尾约定：仓库内所有文本文件统一使用 CRLF，匹配 Windows 开发环境。
# 注意：此文件覆盖 core.autocrlf 设置，优先级最高。

* text=auto eol=crlf

# --- 源代码与配置（显式声明，避免被 git 误判为二进制） ---
*.py        text eol=crlf
*.pyi       text eol=crlf
*.ts        text eol=crlf
*.tsx       text eol=crlf
*.js        text eol=crlf
*.jsx       text eol=crlf
*.mjs       text eol=crlf
*.cjs       text eol=crlf
*.vue       text eol=crlf
*.html      text eol=crlf
*.css       text eol=crlf
*.scss      text eol=crlf
*.json      text eol=crlf
*.json5     text eol=crlf
*.yaml      text eol=crlf
*.yml       text eol=crlf
*.toml      text eol=crlf
*.ini       text eol=crlf
*.cfg       text eol=crlf
*.conf      text eol=crlf
*.md        text eol=crlf
*.txt       text eol=crlf
*.sh        text eol=crlf
*.svg       text eol=crlf
*.xml       text eol=crlf
.gitignore  text eol=crlf
.gitattributes text eol=crlf
.editorconfig  text eol=crlf
Dockerfile  text eol=crlf
Makefile    text eol=crlf
LICENSE     text eol=crlf
*.env*      text eol=crlf

# --- 已知二进制：禁用文本处理 ---
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.bmp       binary
*.pdf       binary
*.pptx      binary
*.xlsx      binary
*.xls       binary
*.docx      binary
*.doc       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.7z        binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary
*.pyc       binary
*.pyd       binary
*.so        binary
*.dll       binary
*.exe       binary
*.pt        binary
*.bin       binary
*.npy       binary
*.npz       binary
*.parquet   binary

# --- Git LFS 资源（保留原有规则） ---
*.mov filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
