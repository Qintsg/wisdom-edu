# 行尾约定：仓库内所有文本文件统一使用 LF，避免 Windows checkout 时被 autocrlf 转成 CRLF。
# 注意：此文件覆盖 core.autocrlf 设置，优先级最高。

* text=auto eol=lf

# --- 源代码与配置（显式声明，避免被 git 误判为二进制） ---
*.py        text eol=lf
*.pyi       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.vue       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.json      text eol=lf
*.json5     text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.conf      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.sh        text eol=lf
*.svg       text eol=lf
*.xml       text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
LICENSE     text eol=lf
*.env*      text eol=lf

# --- 已知二进制：禁用文本处理 ---
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.bmp       binary
*.pdf       binary
*.pptx      binary
*.xlsx      binary
*.xls       binary
*.docx      binary
*.doc       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.7z        binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary
*.pyc       binary
*.pyd       binary
*.so        binary
*.dll       binary
*.exe       binary
*.pt        binary
*.bin       binary
*.npy       binary
*.npz       binary
*.parquet   binary

# --- Git LFS 资源（保留原有规则） ---
*.mov filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
